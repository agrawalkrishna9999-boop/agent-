# Environment Configuration
# Copy this file to .env and fill in your values

# FreeLLMAPI Configuration (free LLM aggregator)
# Option 1: Self-hosted FreeLLMAPI
#   git clone https://github.com/tashfeenahmed/freellmapi.git
#   cd freellmapi && npm install && npm run dev
# Option 2: Use public instance (if available)
FREELLM_API_URL=http://localhost:3001/v1
FREELLM_API_KEY=default-key
LLM_MODEL=gpt-3.5-turbo

# Server
PORT=3001
NODE_ENV=development
